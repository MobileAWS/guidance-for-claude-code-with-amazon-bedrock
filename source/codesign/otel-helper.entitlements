<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Keychain access for reading authentication tokens -->
    <key>keychain-access-groups</key>
    <array>
        <string>$(AppIdentifierPrefix)com.anthropic.claude-code-with-bedrock</string>
    </array>
    
    <!-- Network access for telemetry endpoints -->
    <key>com.apple.security.network.client</key>
    <true/>
    
    <!-- App Sandbox (hardened runtime) -->
    <key>com.apple.security.app-sandbox</key>
    <true/>
    
    <!-- Allow reading files for configuration -->
    <key>com.apple.security.files.user-selected.read-only</key>
    <true/>
    
    <!-- Disable library validation for compatibility -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    
    <!-- Allow DYLD environment variables -->
    <key>com.apple.security.cs.allow-dyld-environment-variables</key>
    <true/>
    
    <!-- Allow unsigned executable memory for Go runtime -->
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    
    <!-- JIT compilation support -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
</dict>
</plist>
